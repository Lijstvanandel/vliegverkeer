rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPunctualityLogEntry(data) {
      return data.keys().hasAll([
        'id',
        'ownerId',
        'timestamp',
        'date',
        'yearMonth',
        'isoYear',
        'isoWeek',
        'yearWeek',
        'stopId',
        'stopCode',
        'stopName',
        'town',
        'line',
        'operator',
        'destination',
        'journeyId',
        'plannedTime',
        'actualTime',
        'delayMinutes',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerId',
        'timestamp',
        'date',
        'yearMonth',
        'isoYear',
        'isoWeek',
        'yearWeek',
        'stopId',
        'stopCode',
        'stopName',
        'town',
        'line',
        'operator',
        'destination',
        'journeyId',
        'plannedTime',
        'actualTime',
        'delayMinutes',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64 &&
      data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
      data.yearMonth is string && data.yearMonth.size() == 7 && data.yearMonth.matches('^\\d{4}-\\d{2}$') &&
      data.isoYear is number && data.isoYear >= 2020 && data.isoYear <= 2100 &&
      data.isoWeek is number && data.isoWeek >= 1 && data.isoWeek <= 53 &&
      data.yearWeek is string && data.yearWeek.size() == 8 && data.yearWeek.matches('^\\d{4}-W\\d{2}$') &&
      data.stopId is string && data.stopId.size() >= 1 && data.stopId.size() <= 64 &&
      data.stopCode is string && data.stopCode.size() >= 1 && data.stopCode.size() <= 64 &&
      data.stopName is string && data.stopName.size() >= 1 && data.stopName.size() <= 120 &&
      data.town is string && data.town.size() >= 1 && data.town.size() <= 80 &&
      data.line is string && data.line.size() >= 1 && data.line.size() <= 16 &&
      data.operator is string && data.operator.size() >= 1 && data.operator.size() <= 64 &&
      data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 120 &&
      data.journeyId is string && data.journeyId.size() >= 1 && data.journeyId.size() <= 80 &&
      data.plannedTime is string && data.plannedTime.size() >= 1 && data.plannedTime.size() <= 16 &&
      data.actualTime is string && data.actualTime.size() >= 1 && data.actualTime.size() <= 32 &&
      data.delayMinutes is number && data.delayMinutes >= -120 && data.delayMinutes <= 600 &&
      data.status is string && data.status.size() >= 5 && data.status.size() <= 16 && data.status in ['ontime', 'delayed', 'early', 'cancelled'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidFlightPassageArchive(data) {
      return data.keys().hasAll([
        'id',
        'ownerId',
        'passageId',
        'municipalityCode',
        'icao24',
        'callsign',
        'registration',
        'icaoTypeCode',
        'modelName',
        'operatorName',
        'trafficCategory',
        'isMilitary',
        'hasMlat',
        'entryTime',
        'lastSeenTime',
        'exitTime',
        'isActive',
        'entryLat',
        'entryLon',
        'exitLat',
        'exitLon',
        'minAltM',
        'maxAltM',
        'pointCount',
        'depIata',
        'arrIata',
        'routeStatus',
        'positions',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerId',
        'passageId',
        'municipalityCode',
        'icao24',
        'callsign',
        'registration',
        'icaoTypeCode',
        'modelName',
        'operatorName',
        'trafficCategory',
        'isMilitary',
        'hasMlat',
        'entryTime',
        'lastSeenTime',
        'exitTime',
        'isActive',
        'entryLat',
        'entryLon',
        'exitLat',
        'exitLon',
        'minAltM',
        'maxAltM',
        'pointCount',
        'depIata',
        'arrIata',
        'routeStatus',
        'positions',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.passageId is string && data.passageId.size() >= 1 && data.passageId.size() <= 128 && data.passageId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.municipalityCode is string && data.municipalityCode.size() >= 1 && data.municipalityCode.size() <= 16 &&
      data.icao24 is string && data.icao24.size() >= 4 && data.icao24.size() <= 16 &&
      data.callsign is string && data.callsign.size() >= 1 && data.callsign.size() <= 24 &&
      data.registration is string && data.registration.size() >= 1 && data.registration.size() <= 24 &&
      data.icaoTypeCode is string && data.icaoTypeCode.size() >= 1 && data.icaoTypeCode.size() <= 16 &&
      data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 120 &&
      data.operatorName is string && data.operatorName.size() >= 1 && data.operatorName.size() <= 120 &&
      data.trafficCategory is string && data.trafficCategory.size() >= 4 && data.trafficCategory.size() <= 32 &&
      data.trafficCategory in ['commercial', 'general_aviation', 'hems_police_sar', 'military', 'unknown'] &&
      data.isMilitary is bool &&
      data.hasMlat is bool &&
      data.entryTime is string && data.entryTime.size() >= 1 && data.entryTime.size() <= 64 &&
      data.lastSeenTime is string && data.lastSeenTime.size() >= 1 && data.lastSeenTime.size() <= 64 &&
      data.exitTime is string && data.exitTime.size() >= 1 && data.exitTime.size() <= 64 &&
      data.isActive is bool &&
      data.entryLat is number && data.entryLat >= -90 && data.entryLat <= 90 &&
      data.entryLon is number && data.entryLon >= -180 && data.entryLon <= 180 &&
      data.exitLat is number && data.exitLat >= -90 && data.exitLat <= 90 &&
      data.exitLon is number && data.exitLon >= -180 && data.exitLon <= 180 &&
      data.minAltM is number && data.minAltM >= -999 && data.minAltM <= 50000 &&
      data.maxAltM is number && data.maxAltM >= -999 && data.maxAltM <= 50000 &&
      data.pointCount is number && data.pointCount >= 1 && data.pointCount <= 50000 &&
      data.depIata is string && data.depIata.size() >= 1 && data.depIata.size() <= 16 &&
      data.arrIata is string && data.arrIata.size() >= 1 && data.arrIata.size() <= 16 &&
      data.routeStatus is string && data.routeStatus.size() >= 5 && data.routeStatus.size() <= 32 &&
      data.routeStatus in ['enriched', 'partial_route_only', 'not_applicable_vfr_mil', 'quota_skipped', 'not_found', 'pending'] &&
      data.positions is list && data.positions.size() >= 1 && data.positions.size() <= 350 && data.positions[0] is map &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /punctualityLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(logId) &&
        isValidPunctualityLogEntry(incoming()) &&
        incoming().id == logId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(logId) &&
        isValidPunctualityLogEntry(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['timestamp', 'actualTime', 'delayMinutes', 'status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(logId) && existing().ownerId == request.auth.uid;
    }

    match /flightPassages/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(docId) &&
        isValidFlightPassageArchive(incoming()) &&
        incoming().id == docId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(docId) &&
        isValidFlightPassageArchive(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().passageId == existing().passageId &&
        incoming().municipalityCode == existing().municipalityCode &&
        incoming().icao24 == existing().icao24 &&
        incoming().entryTime == existing().entryTime &&
        incoming().entryLat == existing().entryLat &&
        incoming().entryLon == existing().entryLon &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'callsign',
          'registration',
          'icaoTypeCode',
          'modelName',
          'operatorName',
          'trafficCategory',
          'isMilitary',
          'hasMlat',
          'lastSeenTime',
          'exitTime',
          'isActive',
          'exitLat',
          'exitLon',
          'minAltM',
          'maxAltM',
          'pointCount',
          'depIata',
          'arrIata',
          'routeStatus',
          'positions',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(docId) && existing().ownerId == request.auth.uid;
    }
  }
}
