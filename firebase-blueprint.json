{
  "entities": {
    "PunctualityLogEntry": {
      "title": "PunctualityLogEntry",
      "description": "Recorded bus stop arrival/departure punctuality, delay, early passage, or cancellation event in Gemeente Steenwijkerland.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique identifier for the logged stop passage"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the authenticated user who owns or synced the log entry"
        },
        "timestamp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "ISO timestamp string when the observation was logged"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date of service (YYYY-MM-DD)"
        },
        "yearMonth": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "Year and month (YYYY-MM)"
        },
        "isoYear": {
          "type": "number",
          "description": "ISO week-numbering year (2020..2100)"
        },
        "isoWeek": {
          "type": "number",
          "description": "ISO week number (1..53)"
        },
        "yearWeek": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8,
          "pattern": "^\\d{4}-W\\d{2}$",
          "description": "Year and ISO week (YYYY-Www)"
        },
        "stopId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Internal stop identifier"
        },
        "stopCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Official DRGL stop code (e.g. NL:S:16301010)"
        },
        "stopName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Bus stop name (Haltenaam)"
        },
        "town": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Town or village name (Plaats)"
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Bus line number (e.g. 26, 70, 214)"
        },
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Transit operator (Qbuzz, RRReis)"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Trip destination"
        },
        "journeyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "DRGL journey identifier"
        },
        "plannedTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Scheduled departure/arrival time (HH:mm)"
        },
        "actualTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Actual departure/arrival time or Uitgevallen"
        },
        "delayMinutes": {
          "type": "number",
          "description": "Delay in minutes (>0 late, <0 early, 0 on time)"
        },
        "status": {
          "type": "string",
          "enum": ["ontime", "delayed", "early", "cancelled"],
          "minLength": 5,
          "maxLength": 16,
          "description": "Passage status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when record was last updated"
        }
      },
      "required": [
        "id",
        "ownerId",
        "timestamp",
        "date",
        "yearMonth",
        "isoYear",
        "isoWeek",
        "yearWeek",
        "stopId",
        "stopCode",
        "stopName",
        "town",
        "line",
        "operator",
        "destination",
        "journeyId",
        "plannedTime",
        "actualTime",
        "delayMinutes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "FlightPassageArchive": {
      "title": "FlightPassageArchive",
      "description": "Persistent cloud backup of an aircraft passage and compact ADS-B/MLAT trajectory over Gemeente Steenwijkerland (GM1708).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document ID matching ownerId_passageId"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID owning this cloud backup record"
        },
        "passageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Original SQLite flight_passages.id"
        },
        "municipalityCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Municipality CBS code (GM1708)"
        },
        "icao24": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "description": "24-bit ICAO transponder address"
        },
        "callsign": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "Flight callsign or dash"
        },
        "registration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "Aircraft tail registration or dash"
        },
        "icaoTypeCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "ICAO aircraft type code or dash"
        },
        "modelName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Aircraft model description or dash"
        },
        "operatorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Operator name or dash"
        },
        "trafficCategory": {
          "type": "string",
          "enum": ["commercial", "general_aviation", "hems_police_sar", "military", "unknown"],
          "minLength": 4,
          "maxLength": 32,
          "description": "Airspace traffic category"
        },
        "isMilitary": {
          "type": "boolean",
          "description": "Whether aircraft is military"
        },
        "hasMlat": {
          "type": "boolean",
          "description": "Whether MLAT positions were present"
        },
        "entryTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "ISO timestamp when aircraft entered GM1708"
        },
        "lastSeenTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "ISO timestamp of last observation inside GM1708"
        },
        "exitTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "ISO timestamp when aircraft exited GM1708 or dash if still active"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the passage was still active when synced"
        },
        "entryLat": {
          "type": "number",
          "description": "Entry latitude"
        },
        "entryLon": {
          "type": "number",
          "description": "Entry longitude"
        },
        "exitLat": {
          "type": "number",
          "description": "Exit latitude (or entryLat fallback)"
        },
        "exitLon": {
          "type": "number",
          "description": "Exit longitude (or entryLon fallback)"
        },
        "minAltM": {
          "type": "number",
          "description": "Minimum altitude in meters (-999 when unknown)"
        },
        "maxAltM": {
          "type": "number",
          "description": "Maximum altitude in meters (-999 when unknown)"
        },
        "pointCount": {
          "type": "number",
          "description": "Total recorded radar points"
        },
        "depIata": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Departure IATA/ICAO code or dash"
        },
        "arrIata": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Arrival IATA/ICAO code or dash"
        },
        "routeStatus": {
          "type": "string",
          "enum": [
            "enriched",
            "partial_route_only",
            "not_applicable_vfr_mil",
            "quota_skipped",
            "not_found",
            "pending"
          ],
          "minLength": 5,
          "maxLength": 32,
          "description": "Route enrichment status"
        },
        "positions": {
          "type": "array",
          "description": "Bounded native array of position maps (1..350 entries)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when cloud record was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when cloud record was last updated"
        }
      },
      "required": [
        "id",
        "ownerId",
        "passageId",
        "municipalityCode",
        "icao24",
        "callsign",
        "registration",
        "icaoTypeCode",
        "modelName",
        "operatorName",
        "trafficCategory",
        "isMilitary",
        "hasMlat",
        "entryTime",
        "lastSeenTime",
        "exitTime",
        "isActive",
        "entryLat",
        "entryLon",
        "exitLat",
        "exitLon",
        "minAltM",
        "maxAltM",
        "pointCount",
        "depIata",
        "arrIata",
        "routeStatus",
        "positions",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/punctualityLogs/{logId}": {
      "schema": {
        "$ref": "PunctualityLogEntry"
      },
      "description": "Stores historical punctuality, delay, early passage, and cancellation observations per bus stop and bus line."
    },
    "/flightPassages/{docId}": {
      "schema": {
        "$ref": "FlightPassageArchive"
      },
      "description": "Stores persistent cloud backups of GM1708 aircraft passages and tracks owned by authenticated users."
    }
  }
}
